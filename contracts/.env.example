# BOT Chain RPC endpoints. Mainnet is the deployment target; testnet is for rehearsal.
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life

# A funded testnet/mainnet key you control. Read only from the environment, never
# committed. There is no mainnet faucet: mainnet BOT must be acquired separately.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=

REFUND_GRACE_PERIOD_SECONDS=604800

BOTCHAIN_EXPLORER_BASE_URL=https://scan.botchain.ai
BOTCHAIN_TESTNET_EXPLORER_BASE_URL=https://scan.bohr.life

# Mainnet defaults to the verified USDT address. Testnet has no canonical USDT, so
# deploy a 6-decimal MockERC20 and point this at it before deploying the escrow.
SETTLEMENT_TOKEN_ADDRESS=

# Only used by scripts/configure-attestor.ts. Must be the address the attestor
# service reports from /info - never the deployer or the owner.
ATTESTOR_SIGNING_ADDRESS=
ATTESTOR_URL=http://127.0.0.1:3000/api/attestor

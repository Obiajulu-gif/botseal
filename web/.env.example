# Copy to .env.local and fill in after deploying. Never commit .env.local.

# --- Network ---------------------------------------------------------------
# 677 = BOT Chain mainnet (the deployment target). 968 = BOT Chain testnet,
# for rehearsal only. Any other id is rejected at startup.
NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_EXPLORER_URL=https://scan.botchain.ai

# --- Deployed contracts ----------------------------------------------------
# From contracts/deployments/coston2.json after `npm run deploy:coston2`.
NEXT_PUBLIC_ESCROW_ADDRESS=
# From the FCC scaffold's deployed addresses after pre-build.sh.
NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS=
# Resolved through FAssets; see contracts/deployments/coston2-resolved.local.json.
NEXT_PUBLIC_FXRP_ADDRESS=

# --- Modes -----------------------------------------------------------------
# Exposes the unverified public-invoice path in the UI. Keep false unless the FCC
# stack is unavailable and the demo needs to continue.
NEXT_PUBLIC_ENABLE_PUBLIC_MODE=false

# --- FCC polling -----------------------------------------------------------
NEXT_PUBLIC_FCC_POLL_INTERVAL_MS=2500
NEXT_PUBLIC_FCC_RESULT_TIMEOUT_MS=180000

# Native-token fee forwarded with sendCreateInvoice, in wei. Leave blank for zero,
# which is correct for the current Coston2 registry. Set it only from the fee the
# FCC scaffold's own test path uses. This is public because the browser wallet
# sends the instruction transaction.
NEXT_PUBLIC_FCC_INSTRUCTION_FEE_WEI=

# --- Server-only -----------------------------------------------------------
# The FCC extension proxy. Never exposed to the browser: pages call /api/fcc/*,
# which proxies to this URL server-side. Use the ngrok/cloudflared HTTPS URL when
# the TEE stack runs behind a tunnel.
FCC_PROXY_URL=http://127.0.0.1:6674

# Production build config for the hosted demo.
#
# Committed deliberately: every value here is public information that is already
# on-chain and in the README. There are no secrets in this file.
#
# NEXT_PUBLIC_* values are inlined at build time, so they must be present when
# Vercel builds — an unset address would bake in "not configured".

NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_EXPLORER_URL=https://scan.botchain.ai

# Filled in during Phase 6, from contracts/deployments/botchain-677.json.
# The previous values here were Coston2 addresses and have been cleared: shipping
# a foreign-chain address would point the hosted app at a contract that does not
# exist on BOT Chain.
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS=
NEXT_PUBLIC_FXRP_ADDRESS=

NEXT_PUBLIC_ENABLE_PUBLIC_MODE=true

NEXT_PUBLIC_FCC_POLL_INTERVAL_MS=2500
NEXT_PUBLIC_FCC_RESULT_TIMEOUT_MS=180000

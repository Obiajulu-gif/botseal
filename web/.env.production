# Production build config for the hosted demo.
#
# Committed deliberately: every value here is public information that is already
# on-chain and in the README. There are no secrets in this file — the attestor
# key is set in the host's secret store, never here.
#
# NEXT_PUBLIC_* values are inlined at build time, so they must be present when
# the host builds — an unset address would bake in "not configured".
#
# Points at BOT Chain Testnet (968), which is where the demo deployment lives.
# Mainnet (677) settles in real USDT and has no deployment yet.

NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life

# From contracts/deployments/botchain-968.json.
NEXT_PUBLIC_ESCROW_ADDRESS=0x926A0215BC58c4897c5604a7E5eeCf5D4d84cc1D

# Test USDT deployed for the demo: "Test USD", USDT, 6 decimals — the same shape
# as mainnet USDT, so the amount math being demonstrated is the production math.
# Its mint() is open, so a reviewer can fund their own wallet.
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=0x358A95Aa014D112CDFbEe5f3eA599BA14B331CBF

# The attestor is configured, so the confidential path works. The unverified
# public fallback stays off.
NEXT_PUBLIC_ENABLE_PUBLIC_MODE=false

# Production build config for the hosted demo.
#
# Committed deliberately: every value here is public information that is already
# on-chain and in the README. There are no secrets in this file.
#
# NEXT_PUBLIC_* values are inlined at build time, so they must be present when
# Vercel builds — an unset address would bake in "not configured".

NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_COSTON2_EXPLORER_URL=https://coston2-explorer.flare.network

NEXT_PUBLIC_ESCROW_ADDRESS=0xEe7aDeb4268CDC40F3138F7caF08432A1433F204
NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS=0xF7F75FF93B500f7199E200Cb665A9573A2b73897
NEXT_PUBLIC_FXRP_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7

# Enabled while the TEE signing address is unset. The confidential relay would
# revert with TeeNotConfigured, so the hosted demo exposes the clearly-labelled
# public path instead. Set to false once configure-tee has run.
NEXT_PUBLIC_ENABLE_PUBLIC_MODE=true

NEXT_PUBLIC_FCC_POLL_INTERVAL_MS=2500
NEXT_PUBLIC_FCC_RESULT_TIMEOUT_MS=180000

# FCC_PROXY_URL is intentionally NOT set here. The TEE stack runs locally behind
# a tunnel and is not reachable from Vercel, so /api/fcc/* correctly returns 503
# "extension-unavailable" and the UI surfaces that state rather than hanging.
